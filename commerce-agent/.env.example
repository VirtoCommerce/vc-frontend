# Model access. Step 4.3 of the scaffold (one live turn) is blocked until this is set.
ANTHROPIC_API_KEY=

# x-api. The endpoint may be given with or without /graphql.
XAPI_ENDPOINT=https://vcst-qa.govirto.com
XAPI_STORE_ID=B2B-store
XAPI_CURRENCY_CODE=USD
XAPI_CULTURE_NAME=en-US
XAPI_TIMEOUT_S=30

# The service answers only to these Host headers (loopback is always allowed) and origins.
AGENT_ALLOWED_HOSTS=
AGENT_ALLOWED_ORIGINS=https?://(localhost|127\.0\.0\.1)(:\d+)?
AGENT_LOG_LEVEL=INFO

# The QA storefront account `python -m evals run` shops as. Its cart is rewritten per case.
EVAL_USERNAME=
EVAL_PASSWORD=
