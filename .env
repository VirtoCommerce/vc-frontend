APP_BACKEND_URL=https://localhost:5001

# Module Federation host: load the plugins the platform advertises for the store (xAPI store.plugins).
# Allowlist semantics - only true/1/yes/on enable it. See client-app/modules/federated/README.md.
APP_MODULES_FEDERATION_ENABLED=true

VUE_APP_I18N_LOCALE=en
VUE_APP_I18N_FALLBACK_LOCALE=en

# you can obtain this API key from the Google AI Studio - https://aistudio.google.com/app/apikey
APP_GEMINI_API_KEY=your_gemini_key

# model name to use for translation https://cloud.google.com/vertex-ai/generative-ai/docs/learn/model-versions#latest-stable
FIX_LOCALES_MODEL_NAME=gemini-2.5-flash-lite
# model temperature - 0.0 means no randomness
FIX_LOCALES_TEMPERATURE=0.0
