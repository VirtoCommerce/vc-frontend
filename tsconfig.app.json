{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["client-app/**/*", "config/*.json", "locales/*.json", "package.json", "backend-packages.json"],
  "exclude": [
    "artifacts",
    "assets",
    "content",
    // Published artifact, not host source: it carries a `declare module "vue"` augmentation of
    // GlobalComponents for plugins, and compiling it here would resolve host templates against the
    // contract's rolled-up copies of the ui-kit prop types instead of the ui-kit's own.
    "client-app/core-api/contract",
    "client-app/**/__tests__/*",
    "client-app/**/*.(test|spec).*",
    "storybook-static"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./client-app/*"]
    }
  }
}
