{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Declaration-emit program for the publish-from-source facade.
  //
  // `build-types.mjs` runs this to emit the facade's whole reachable type graph
  // into `.types-build/`, then rolls it up with rollup-plugin-dts into a single
  // self-contained `dist/index.d.ts`. It is NOT part of the app typecheck.
  //
  // Ambient host declarations must ALL be in scope so the reachable facade graph emits
  // cleanly. The facade re-exports ui-kit barrels (dragging in every component .vue,
  // which reference per-component `declare global` type aliases like VcChipColorType)
  // plus shared/core code that augments `window` (e.g. VCExtensionRegistry). Missing any
  // of those ambient files turned into ~115 tolerated "out-of-surface" diagnostics that
  // could mask a REAL type error in the exported surface — so they are included here and
  // build-types.mjs now fails on ANY emit diagnostic.
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./.types-build",
    "rootDir": "..",
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["../*.d.ts", "../ui-kit/**/*.d.ts", "../shared/common/types/window.d.ts", "./index.ts"],
  "exclude": []
}
