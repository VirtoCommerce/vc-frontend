{
  "name": "@vc-frontend/core",
  "version": "0.1.0",
  "description": "Curated public API surface of the VC B2B storefront host, consumed by Module Federation plugins. Publish-from-source: type contract only \u2014 the running implementation is injected by the host at runtime via MF shared singletons.",
  "type": "module",
  "private": true,
  "files": [
    "contract/index.d.ts",
    "contract/tailwind-preset.cjs",
    "federation.mjs",
    "federation.d.mts",
    "testing.mjs",
    "testing.d.mts"
  ],
  "types": "./contract/index.d.ts",
  "exports": {
    ".": {
      "types": "./contract/index.d.ts"
    },
    "./federation": {
      "types": "./federation.d.mts",
      "import": "./federation.mjs"
    },
    "./testing": {
      "types": "./testing.d.mts",
      "import": "./testing.mjs"
    },
    "./tailwind-preset": "./contract/tailwind-preset.cjs"
  },
  "peerDependencies": {
    "@apollo/client": "^3.14.0",
    "@floating-ui/vue": "^2.0.1",
    "@intlify/core-base": "^11.4.6",
    "@tailwindcss/container-queries": "^0.1.1",
    "@vue/shared": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "lodash-es": "^4.18.1",
    "maska": "^3.2.0",
    "tw-elements": "^1.1.0",
    "utility-types": "^3.11.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/container-queries": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "lodash-es": {
      "optional": true
    },
    "tw-elements": {
      "optional": true
    }
  },
  "scripts": {
    "build:types": "node build-types.mjs"
  }
}
